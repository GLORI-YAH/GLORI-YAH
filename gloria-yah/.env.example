# Copier ce fichier en ".env" et remplir les vraies valeurs — ne jamais committer le .env réel

# Base de données PostgreSQL/PostGIS
DATABASE_URL=postgres://user:password@localhost:5432/gloria_yah

# Sécurité
JWT_SECRET=change-moi-avec-une-valeur-longue-et-aleatoire

# Serveur
PORT=3000

# Passerelles de paiement (zone XOF)
# Kkiapay : 3 clés distinctes, disponibles sur https://app.kkiapay.me (Paramètres > Clés API)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true
# KKIAPAY_VERIFY_URL : vérifier cette URL dans la doc officielle avant mise en prod, elle peut évoluer
KKIAPAY_VERIFY_URL=https://api.kkiapay.me/api/v1/transactions/status

FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox

# Vérification par code SMS (inscription/connexion passager sans mot de passe)
# Compte à créer sur https://africastalking.com — Bénin confirmé dans leur couverture.
# Vérifier le tarif réel au moment de la mise en service (dépend du volume).
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox

# Passerelles hors zone XOF (Ghana, Guinée, Sierra Leone, Liberia, Gambie, Cap-Vert) — à identifier
# GHANA_MOMO_API_KEY=
# FLUTTERWAVE_API_KEY=
